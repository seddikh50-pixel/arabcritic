```prisma
// use prisma-next

types {
  Uuid = String @db.Uuid
}

model User {
  id        Uuid   @id @default(uuid())
  email     String @unique
  username  String @unique
  name      String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Game {
  id          Uuid   @id @default(uuid())
  title       String
  slug        String @unique
  description String?
  cover       String?
  releaseDate TimestamptzString?
  developer   String?
  publisher   String?

  reviews Review[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Reviewer {
  id      Uuid   @id @default(uuid())
  name    String
  slug    String @unique
  avatar  String?
  bio     String?
  website String?

  reviews Review[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Review {
  id          Uuid   @id @default(uuid())
  title       String
  content     String?
  score       Int?
  url         String?
  publishedAt TimestamptzString?

  game       Game     @relation(fields: [gameId], references: [id])
  gameId     Uuid

  reviewer   Reviewer @relation(fields: [reviewerId], references: [id])
  reviewerId Uuid

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([gameId, reviewerId])
  @@index([gameId])
  @@index([reviewerId])
}
